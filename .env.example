# --- Host ports ---
GATEWAY_PORT=8080
ADMIN_PORT=8081
PANEL_PORT=3001

# --- Environment / TLS posture ---
# "development" disables the session cookie's Secure flag for local http.
# Set to anything else once this is actually served over HTTPS.
ENV=development
# Only send Strict-Transport-Security once this is genuinely served over
# HTTPS end to end (see the comment in internal/httpx/hsts.go).
HSTS_ENABLED=false

# --- Panel / CORS (admin API only — gateway allows any origin, since it's
# authenticated by API key, not a cookie, and is meant to be called from
# arbitrary integrations, not just the panel) ---
# Must be the exact origin the panel is actually reachable at (scheme +
# host + port, no trailing slash) — used both for CORS and the admin API's
# CSRF check, so a mismatch breaks the panel outright.
CORS_ALLOWED_ORIGIN=http://localhost:3001
ADMIN_API_URL=http://localhost:8081
# "lax" if the panel and the admin API share a root domain, "none" if
# they're on unrelated domains (also forces the cookie's Secure flag on,
# regardless of ENV).
COOKIE_SAMESITE=lax

# --- Redis ---
REDIS_USERNAME=ostiary
# FILL IN: a real password for both the default Redis user and the scoped
# ostiary ACL user (redis-init creates the latter using this same value).
REDIS_PASSWORD=redis-password-change-me
REDIS_POOL_SIZE=5000
# How long each gateway keeps a consumer's session in memory in front of Redis
# (a Go duration, e.g. 30s or 5m). Also the longest a change made in the panel,
# such as switching a key off, takes to reach every gateway. 0 turns it off.
LOCAL_CACHE_TTL=5m

# --- Postgres ---
# FILL IN: a real password for the postgres superuser — used both by the
# postgres service itself and by gateway/admin's own connection strings.
POSTGRES_PASSWORD=postgres-password-change-me
# Whether the gateway creates and updates the database tables when it starts.
# Set to false only if you manage the schema yourself.
POSTGRE_AUTO_MIGRATE=true
POSTGRE_MAX_OPEN_CONNS=75
POSTGRE_MAX_IDLE_CONNS=75
ADMIN_POSTGRE_MAX_OPEN_CONNS=10
ADMIN_POSTGRE_MAX_IDLE_CONNS=5

# --- Outbound connections to LLM providers (gateway only) ---
# Idle connections above this cap get closed instead of reused. Too low
# under heavy concurrent load to one shared provider key just means more
# TCP/TLS handshake churn, not failed requests.
PROVIDER_MAX_IDLE_CONNS=2000
PROVIDER_MAX_IDLE_CONNS_PER_HOST=2000
# Where each provider's models are reached (http or https, no trailing slash).
# Provider keys are sent there.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Usage queue (gateway only) ---
# How many usage tasks each gateway writes to Postgres at once. Each one
# holds a Postgres connection, so keep it well below POSTGRE_MAX_OPEN_CONNS.
USAGE_WORKER_CONCURRENCY=10
# How many times a usage task that fails to write is retried before asynq
# archives it. The waits between retries grow, so 25 keeps retrying for weeks.
USAGE_TASK_MAX_RETRY=25
# How long a provider's answer is still read, for its usage, after the client
# that asked for it has gone away (a Go duration, e.g. 30s or 2m).
USAGE_DRAIN_LIMIT=1m

# --- Secrets ---
# FILL IN: a real secret used to sign admin JWTs.
JWT_SECRET=jwt-secret-change-me
# How long a panel sign-in lasts, in hours.
JWT_EXPIRATION_HOURS=48
# FILL IN: required as the x-api-key header value to call GET /health on
# either service — keeps dependency status from being publicly readable.
HEALTH_CHECK_TOKEN=health-check-token-change-me
# FILL IN: required as the x-api-key header value to read GET /metrics on
# either service. Give it to Prometheus, not the health token.
METRICS_TOKEN=metrics-token-change-me
# FILL IN (required, no default): base64-encoded 32-byte AES-256 key for
# LocalKMS. Generate one with: openssl rand -base64 32
LOCAL_KMS_MASTER_KEY=replace-with-the-output-of-openssl-rand-base64-32

# --- GCP KMS (optional — only used with docker compose -f docker-compose.yml -f docker-compose.gcp.yml) ---
# GCP_KMS_KEY_NAME=projects/PROJECT_ID/locations/LOCATION/keyRings/ostiary/cryptoKeys/dek-wrapper
# GCP_KMS_CREDENTIALS_FILE=./gcp-kms-key.json

# --- OpenBao KMS (optional — only used with docker compose -f docker-compose.yml -f docker-compose.openbao.yml) ---
# Doubles as OpenBao's own root token (BAO_DEV_ROOT_TOKEN_ID) and what
# gateway/admin authenticate with. 
# OPENBAO_VAULT_TOKEN=dev-root-token
# Name of the Transit key openbao-init creates and gateway/admin use to
# wrap/unwrap DEKs. Only change this if you want a distinct key per
# environment sharing the same OpenBao instance.
# OPENBAO_VAULT_KEYNAME=ostiary-dek-wrap

# --- Seq (optional — both empty disables it, local stderr logging is unaffected either way) ---
# Must be the full CLEF ingestion endpoint, not just the server's base URL —
# this is sent as the literal request URL with nothing appended.
# SEQ_URL=https://your-seq-instance/ingest/clef
# SEQ_API_KEY=
